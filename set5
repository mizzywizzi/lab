%{
#include<stdio.h>
int i;
%}

%%
[a-zA-Z]+ {
    for(i=0; yytext[i]!='\0'; i++)
    {
        if(yytext[i]=='a' && yytext[i+1]=='b' && yytext[i+2]=='c')
        {
            yytext[i]='A';
            yytext[i+1]='B';
            yytext[i+2]='C';
        }
    }
    printf("%s",yytext);
}

\n {
    printf("\n");
}

. {
    printf("%s",yytext);
}
%%

int main()
{
    yylex();
    return 0;
}

int yywrap()
{
    return 1;
}

