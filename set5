%{
#include <stdio.h>

int yylex(void);
int yyerror(const char *s);
int valid = 1;
%}

%token ALPHA DIGIT

%%

start : ALPHA s
      ;

s : ALPHA s
  | DIGIT s
  |
  ;

%%

int yyerror(const char *s)
{
    valid = 0;
    return 0;
}

int main()
{
    printf("Enter a string: ");
    yyparse();

    if (valid)
        printf("Valid\n");
    else
        printf("Invalid\n");

    return 0;
}
